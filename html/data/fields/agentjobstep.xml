      <language id="en">Id</language>
    </name>
  </property>


 <property id="markdowncontent" keyword="true" index="true" indextype="not_analyzed" editable="true" stored="true" viewtype="markdown"> 
    <name> 
      <language id="en"><![CDATA[Markdown Content]]></language>  
      <language id="de"><![CDATA[Markdown-Inhalt]]></language>
      <language id="fr"><![CDATA[Contenu au format Markdown]]></language>
      <language id="es"><![CDATA[Contenido Markdown]]></language>
    </name> 
  </property> 

  <property id="agentjob" index="true" stored="true" editable="true" type="list">
