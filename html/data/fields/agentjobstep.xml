  <property id="status" index="true" stored="true" editable="true" type="list" listid="jobstatus">
    <name>
      <language id="en">Status</language>
    </name>
  </property>

  <property id="parameters" editable="true" indextype="not_analyzed" index="true" stored="true"> 
