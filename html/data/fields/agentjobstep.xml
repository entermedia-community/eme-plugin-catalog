      <language id="en">Agent Job</language>
    </name>
  </property>

  <property id="aiskillid" index="true" stored="true" editable="true" type="list" listid="aiskill">
    <name>
      <language id="en">Skill</language>
    </name>
  </property>

  <property id="automationscenario" index="true" stored="true" editable="true" type="list" listid="automationscenario">
