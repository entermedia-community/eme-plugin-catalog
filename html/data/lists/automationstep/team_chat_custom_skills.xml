        </name>
     </data>

<!-- Start rendering the incomplete job in a loop. Once it's done continue to final markdown... or back to the team_chat_custom_skills_user_request for the next command -->


    <data id="team_chat_custom_skills_markdown" aiskill="markdownToHtmlSkill" automationscenario="team_chat_custom_skills" enabled="true" agenttype="eventagent" processingmessage="Rendering Markdown to HTML" runafter="team_chat_custom_skills_runner" >
