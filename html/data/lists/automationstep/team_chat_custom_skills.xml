    <data id="team_chat_custom_skills_user_request" aiskill="openCodeUserRequestSkill" automationscenario="team_chat_custom_skills" enabled="true" agenttype="eventagent" processingmessage="Reading Request" runafter="team_chat_custom_skills_welcome">
