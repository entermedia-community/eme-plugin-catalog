      <language id="en"><![CDATA[Run Custom Skill Confirmation]]></language>
    </name>
  </data>

<data id="team_chat_custom_skills_welcome" runafter="team_chat_custom_skills_confirm" aiskill="renderLocalTemplateSkill" automationscenario="team_chat_custom_skills" enabled="true" processingmessage="Welcome..."> 
