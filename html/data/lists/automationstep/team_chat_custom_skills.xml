        </name>
     </data>

    <data id="team_chat_custom_skills_runner" aiskill="openCodeRunnerSkill" automationscenario="team_chat_custom_skills" enabled="true" agenttype="eventagent" processingmessage="Running Command"  runafter="team_chat_custom_skills_user_request">
