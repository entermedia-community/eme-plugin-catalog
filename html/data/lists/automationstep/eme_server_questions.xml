<?xml version="1.0" encoding="UTF-8"?>

<!-- Copy of entity_chat_questions for the eme_server label. QuestionsConfirmSkill finds these steps by aiskill, not by id -->
<records>

   <data id="eme_server_questions_confirm" aiskill="questionsMakeSuggestionsSkill" automationscenario="eme_server_questions" enabled="true" agenttype="eventagent" processingmessage="Creating Suggestions">
      <name>
         <![CDATA[Create Suggestions]]>
      </name>
   </data>

   <data id="eme_server_questions_select_question" aiskill="questionsConfirmSkill" automationscenario="eme_server_questions" enabled="true" runafter="eme_server_questions_confirm" processingmessage="Thinking">
      <name>
         <![CDATA[Handle Questions in Chat]]>
      </name>
   </data>

   <data id="eme_server_questions_ask" aiskill="questionsAskSkill" automationscenario="eme_server_questions" enabled="true" runafter="eme_server_questions_select_question" processingmessage="Answering Question">
      <name>
         <![CDATA[Answer Question]]>
      </name>
   </data>

</records>
