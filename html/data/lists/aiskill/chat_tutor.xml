<?xml version="1.0" encoding="UTF-8"?>

<!-- using more descriptive ids for easier debugging -->
<records> 
  <data id="adaptiveTutorialWelcomeSkill" bean="adaptiveTutorialWelcomeSkill" contextbean="tutorMessageContext" agenttype="remoteagent" ordering="10"> 
    <name> 
      <language id="en"><![CDATA[Tutor Chat Welcome]]></language>  
      <language id="de"><![CDATA[Tutor-Chat: Willkommen]]></language>
      <language id="fr"><![CDATA[Bienvenue dans le chat de tutorat.]]></language>
      <language id="es"><![CDATA[Bienvenido al Tutor Chat]]></language>
    </name> 
    <skilloverview>
      <language id="en"><![CDATA[Initializes adaptive tutorial sessions, displays welcome greeting, and loads tutorial or daily challenge topics.]]></language>
    </skilloverview>
  </data>  
  <data id="adaptiveTutorialContinueSkill" bean="adaptiveTutorialContinueSkill" contextbean="tutorMessageContext" agenttype="remoteagent" ordering="20"> 
    <name> 
      <language id="en"><![CDATA[Tutor Chat Continue]]></language>  
      <language id="de"><![CDATA[Tutor-Chat fortsetzen]]></language>
      <language id="fr"><![CDATA[Continuer la discussion avec le tuteur]]></language>
      <language id="es"><![CDATA[Continuar el chat con el tutor]]></language>
    </name> 
    <skilloverview>
      <language id="en"><![CDATA[Manages tutorial progression, selects the next section or question, and tracks user responses.]]></language>
    </skilloverview>
  </data>  
  <data id="adaptiveTutorialAnswerSkill" bean="adaptiveTutorialAnswerSkill" contextbean="tutorMessageContext" agenttype="remoteagent" ordering="30"> 
    <name> 
      <language id="en"><![CDATA[Tutor Chat Answer]]></language>  
      <language id="de"><![CDATA[Antwort des Tutoren-Chat]]></language>
      <language id="fr"><![CDATA[Réponse du chat du tuteur]]></language>
      <language id="es"><![CDATA[Respuesta del tutor en el chat]]></language>
    </name> 
    <skilloverview>
      <language id="en"><![CDATA[Evaluates user answers against questions, calculates points based on cognitive level and confidence, and records results.]]></language>
    </skilloverview>
  </data>  
  <data id="adaptiveTutorialProgressSkill" bean="adaptiveTutorialProgressSkill" contextbean="tutorMessageContext" agenttype="remoteagent" ordering="40"> 
    <name> 
      <language id="en"><![CDATA[Tutor Progress]]></language>  
      <language id="de"><![CDATA[Fortschritt des Tutors]]></language>
      <language id="fr"><![CDATA[Progrès du tuteur]]></language>
      <language id="es"><![CDATA[Progreso del tutor]]></language>
    </name> 
    <skilloverview>
      <language id="en"><![CDATA[Calculates cumulative tutorial scores, competency levels (beginner, competent, expert), and completion metrics.]]></language>
    </skilloverview>
  </data>  
  <data id="adaptiveTutorialUserCommentSkill" bean="adaptiveTutorialUserCommentSkill" contextbean="tutorMessageContext" agenttype="remoteagent" ordering="50"> 
    <name> 
      <language id="en"><![CDATA[Tutor Chat User Comment]]></language>  
      <language id="de"><![CDATA[Tutor-Chat-Benutzerkommentar]]></language>
      <language id="fr"><![CDATA[Commentaire de l'utilisateur]]></language>
      <language id="es"><![CDATA[Comentario del usuario del tutor]]></language>
    </name> 
    <skilloverview>
      <language id="en"><![CDATA[Answers user comments and questions during tutorials using embedding search over tutorial knowledge.]]></language>
    </skilloverview>
  </data>  
  <data id="adaptiveTutorialEndSkill" bean="adaptiveTutorialEndSkill" contextbean="tutorMessageContext" agenttype="remoteagent" ordering="60"> 
    <name> 
      <language id="en"><![CDATA[Tutor Chat End]]></language>  
      <language id="de"><![CDATA[Tutor-Chat beendet]]></language>
      <language id="fr"><![CDATA[Fin de la discussion avec le tuteur]]></language>
      <language id="es"><![CDATA[Fin del chat con el tutor]]></language>
    </name> 
    <skilloverview>
      <language id="en"><![CDATA[Concludes the adaptive tutorial session, marks the channel finished, and presents the final summary.]]></language>
    </skilloverview>
  </data> 
</records>
