  <data id="semantictopics" bean="semanticClassifierSkill" fieldname="semantictopics" searchtype="semanticembedding" contextbean="informaticsContext" enabled="true" agenttype="taskagent" fieldsavevector="vectorarray" aicreationdescription="You are an assistant that analyzes a batch of metadata inputs and creates a 3 very short semantic summary  in the same language as specified in the metadata that describe the underlying concepts, emotions, actions, and themes. Focus on the essence of what is happening, abstract ideas, moods, and relationships. NOT generic object names unless they are essential to the concept. This summaries are used for clustering, search, filtering, and recommendations. Each semantic summary should be 4 to 7 words. " aicreationcommand="Generate up to 3 semantic summary, in the same language as the content, based on the following metadata:" maxnumberofcentroids="4" init_loop_start_distance=".60" init_loop_lower_limit=".50" maxdistancetocentroid=".67" maxdistancetocentroid_one=".78" maxdistancetomatch=".455" ordering="400"> 
    <name> 
      <language id="en"><![CDATA[Semantic Topics]]></language>  
